<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The database password stays in the developer's user secrets, outside this folder. -->
  <PropertyGroup>
    <UserSecretsId>itti-inside-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Itti.Inside.Application\Itti.Inside.Application.csproj" />
    <ProjectReference Include="..\Itti.Inside.Infrastructure\Itti.Inside.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Holds the local demo sign-in, which has no place on a server. -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
