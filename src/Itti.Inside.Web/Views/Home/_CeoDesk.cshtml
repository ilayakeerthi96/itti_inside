@using Microsoft.Extensions.Options
@model CeoMessage
@inject IOptions<PortalLinkOptions> Links
@{
    // The full message lives on the current intranet. Without that address, use this site's page.
    var moreHref = Links.Value.CeoDesk.Length > 0 ? Links.Value.CeoDesk : Url.Content("~/ceo-desk");
}

<section class="panel ceo" id="ceo-desk" aria-labelledby="ceo-desk-title">
    <div class="ceo__art">
        <img src="~/images/art/ceo-podium.svg" alt="" width="240" height="240" loading="lazy" />
    </div>
    <div class="ceo__body">
        <h2 class="panel__title" id="ceo-desk-title">CEO's Desk</h2>
        <p class="ceo__excerpt">@Model.Excerpt</p>
        <a class="btn-portal" href="@moreHref" new-tab="true">More <icon name="arrow-right" /></a>
    </div>
</section>
