@model MasterSectionViewModel<Holiday, HolidayForm>
@{
    ViewData["Title"] = "Holidays";

    var filePanel = new DocumentPanelModel(
        "Holiday list file",
        "Upload HR's holiday list. Employees can download it from the Holidays page. A Word file with a table of dates also fills in the list below.",
        ".docx,.pdf,.xlsx",
        ViewData[nameof(PortalDocumentInfo)] as PortalDocumentInfo,
        OffersListUpdate: true);
}

<partial name="~/Views/Master/_DocumentPanel.cshtml" model="filePanel" />

<section class="panel" aria-labelledby="master-form-title">
    <h2 class="panel__title" id="master-form-title">@(Model.IsEditing ? "Edit holiday" : "Add a holiday")</h2>

    <form class="master-form" method="post" asp-action="Save">
        <input asp-for="Form.Id" type="hidden" />

        <div class="master-form__row master-form__row--wide-first">
            <div class="master-field">
                <label class="form-label" asp-for="Form.Name"></label>
                <input class="form-control" asp-for="Form.Name" maxlength="@ContentLimits.ShortText" required />
                <span class="master-field__error" asp-validation-for="Form.Name"></span>
            </div>

            <div class="master-field">
                <label class="form-label" asp-for="Form.Date"></label>
                <input class="form-control" asp-for="Form.Date" required />
                <span class="master-field__error" asp-validation-for="Form.Date"></span>
            </div>
        </div>

        <div class="form-check master-check">
            <input class="form-check-input" asp-for="Form.IsOptional" />
            <label class="form-check-label" asp-for="Form.IsOptional"></label>
        </div>

        <partial name="~/Views/Master/_FormButtons.cshtml" model="Model.IsEditing" />
    </form>
</section>

<section class="panel" aria-labelledby="master-list-title">
    <h2 class="panel__title" id="master-list-title">Holidays</h2>

    @if (Model.Items.Count == 0)
    {
        <p class="master-empty">Nothing here yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle master-table">
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Day</th>
                        <th scope="col">Holiday</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="text-nowrap">@item.Date.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td>
                            <td>@item.Date.DayOfWeek</td>
                            <td>
                                @item.Name
                                @if (item.IsOptional)
                                {
                                    <span class="tag">Optional</span>
                                }
                            </td>
                            <td><partial name="~/Views/Master/_RowActions.cshtml" model="item.Id" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<partial name="~/Views/Master/_TextForm.cshtml" model="Model.Text" />
