@model MainNavigationViewModel
@{
    // The master pages get the admin header. Every other page, for visitors and admins alike,
    // gets the portal menu, so an admin sees the landing page exactly as everyone else does.
    var isAdminHeader = Model.IsMasterArea && User.IsInRole(PortalRoles.Admin);

    // Menu entries either open a page on this site or go to another site, such as the current intranet.
    string Href(NavigationItem item) => item.IsExternal ? item.Path! : Url.Content($"~{item.Path}");

    // Only the entries marked newTab in the menu file open in a new tab: Applications, QA and Training.
}

<header class="site-header">
    <nav class="navbar navbar-expand-lg navbar-dark" aria-label="Main">
        <div class="container-xxl">
            <a class="navbar-brand" href="@Url.Content(isAdminHeader ? "~/master" : "~/")">
                <img src="~/images/brand/inside-logo.png" alt="ITTI Inside" width="167" height="78" />
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#portalNav"
                    aria-controls="portalNav" aria-expanded="false" aria-label="Toggle navigation">
                <icon name="menu" />
            </button>

            <div class="collapse navbar-collapse" id="portalNav">
                <ul class="navbar-nav">
                    @if (isAdminHeader)
                    {
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" href="~/master">Master</a>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="nav-link">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            var isActive = Model.IsActive(item);

                            if (item.HasChildren)
                            {
                                <li class="nav-item dropdown">
                                    <button type="button" class="nav-link dropdown-toggle @(isActive ? "active" : null)"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                        @item.Title
                                    </button>
                                    <ul class="dropdown-menu">
                                        @foreach (var child in item.Children)
                                        {
                                            <li>
                                                <a class="dropdown-item @(Model.IsActive(child) ? "active" : null)"
                                                   href="@Href(child)" new-tab="@child.OpensInNewTab">@child.Title</a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(isActive ? "active" : null)"
                                       aria-current="@(isActive ? "page" : null)"
                                       href="@Href(item)" new-tab="@item.OpensInNewTab">@item.Title</a>
                                </li>
                            }
                        }
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
