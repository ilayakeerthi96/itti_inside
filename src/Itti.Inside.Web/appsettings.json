{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Provider": "Demo",
    "SessionMinutes": 480
  },
  "RateLimiting": {
    "SignInAttemptsPerMinute": 10
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "ReverseProxy": {
    "KnownProxies": []
  }
}
